# --- Base de données ---
# SQLite local pour le développement (Prisma créera le fichier au premier migrate)
DATABASE_URL="file:./prisma/dev.db"

# --- Auth.js ---
# Générer avec : openssl rand -base64 32
AUTH_SECRET="change-me-with-a-real-secret-32-chars-min"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# --- Compte admin par défaut (utilisé par le seed) ---
ADMIN_EMAIL="admin@indescent-nails.local"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Indescent Nails"

# --- Email (stub en MVP, vraie config en phase 4) ---
EMAIL_FROM="contact@indescent-nails.local"
EMAIL_ADMIN_TO="contact@indescent-nails.local"
